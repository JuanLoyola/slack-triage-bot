# Slack app (https://api.slack.com/apps → your app → Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# LLM provider
OPENAI_API_KEY=sk-...
TRIAGE_MODEL=gpt-4o-mini

# Per-author throttle: max @mentions answered per window (protects token budget)
RATE_LIMIT_PER_AUTHOR=5
RATE_LIMIT_WINDOW_SECONDS=60
